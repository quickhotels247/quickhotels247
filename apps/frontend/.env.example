# Backend address (the app adds /api).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clerk Dashboard -> Configure -> API keys -> Publishable key (pk_...).
# Never put the secret sk_ key here: NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public address of the site, for canonical links, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
