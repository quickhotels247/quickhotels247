# PostgreSQL (Neon now, AWS RDS later). From the Neon dashboard's Connect button:
# DATABASE_URL is the pooled URL (host contains "-pooler") and is what the app
# uses. DIRECT_URL is the same URL without "-pooler" and is used for migrations.
# Use sslmode=verify-full. On RDS both are the same URL.
DATABASE_URL=
DIRECT_URL=

PORT=8080
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# How long a login session lasts, in hours.
SESSION_TTL_HOURS=168

# Outgoing email (sign-up verification codes). Without SMTP_HOST, codes are
# printed to the backend console instead (not allowed when NODE_ENV=production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to users. Defaults to "QuickHotels24/7 <SMTP_USER>" (required by Gmail).
MAIL_FROM=

# Google/GitHub sign-in via Clerk: Clerk Dashboard -> Configure -> API keys -> Secret key.
# Leave empty to disable those buttons.
CLERK_SECRET_KEY=

# How long an admin stays signed in, in hours.
ADMIN_SESSION_TTL_HOURS=12
# Required in production to create the first admin through /admin/signup.
# Share it with the initial admin out of band. If unset, create the first
# admin from the server with `yarn workspace @quickhotels/backend db:create-admin`.
ADMIN_SETUP_TOKEN=
# Set to the number of trusted reverse proxies in front of the backend.
TRUST_PROXY=
# Optional pool tuning; defaults to 20 DB connections.
PG_POOL_MAX=20
# Seconds-long connects are normal far from the database; raise this if needed.
PG_CONNECT_TIMEOUT_MS=15000

# Website address.
FRONTEND_URL=http://localhost:3000

# Hotel supplier: "tripjack", or leave unset for the sample supplier (made-up
# hotels for development; the server refuses to start with it in production).
HOTEL_SUPPLIER=
# TripJack API (backend only; never put it in the frontend).
TRIPJACK_API_KEY=
# Test (UAT) hosts by default. Confirm against TripJack's documentation and
# set the production hosts here when going live.
TRIPJACK_HMS_BASE_URL=
TRIPJACK_BOOKER_BASE_URL=
# Header the key is sent in (TripJack's docs say which; "apikey" by default).
TRIPJACK_AUTH_HEADER=
TRIPJACK_TIMEOUT_MS=20000
