# TEMPLATE ONLY: committed to git, so never put real values here.
# Copy to .env.backend (git-ignored), fill that in, and copy it to the server:
#   cp deploy/aws/.env.backend.example deploy/aws/.env.backend
#   scp -i quickhotels-key.pem deploy/aws/.env.backend ubuntu@13.127.171.94:/opt/quickhotels/.env.backend

# --- Database (AWS RDS, Mumbai) ---
# Letters/numbers-only password, or URL-encode special characters (# → %23).
DATABASE_URL=postgresql://quickhotels:PASSWORD@quickhotels-db.c5g2emc2osnb.ap-south-1.rds.amazonaws.com:5432/quickhotels?sslmode=require
# Migrations run at every start and use this one.
DIRECT_URL=postgresql://quickhotels:PASSWORD@quickhotels-db.c5g2emc2osnb.ap-south-1.rds.amazonaws.com:5432/quickhotels?sslmode=require

# --- Website ---
FRONTEND_URL=https://quickhotels247.com
CORS_ORIGINS=https://quickhotels247.com,https://www.quickhotels247.com
# Caddy is the one proxy in front. Make it 2 if Cloudflare's orange cloud is turned on.
TRUST_PROXY=1

# --- TripJack (this server's IP 13.127.171.94 is whitelisted) ---
HOTEL_SUPPLIER=tripjack
TRIPJACK_API_KEY=
# Leave the base URLs out to stay on TripJack's test (UAT) servers.
# TRIPJACK_HMS_BASE_URL=
# TRIPJACK_BOOKER_BASE_URL=
# TRIPJACK_AIR_BASE_URL=

# --- Sign-in ---
CLERK_SECRET_KEY=
# Only needed to create the first admin; remove it afterwards.
# ADMIN_SETUP_TOKEN=
# Signs the "view booking" links in emails. Make one with: openssl rand -hex 32
# (set it once and keep it: changing it breaks links in old emails).
BOOKING_LINK_SECRET=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Gmail API) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
# SUPPORT_EMAIL=
